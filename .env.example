# Runtime configuration for the local server

# Minimum number of client updates to buffer before aggregating (>= 1)
FL_BUFFER_TARGET=3

# Size of the model's input layer (>= 1)
FL_INPUT_SIZE=20

# Size of the model's hidden layer (>= 1)
FL_HIDDEN_SIZE=16

# Size of the model's output layer (>= 2)
FL_OUTPUT_SIZE=2

# Learning rate applied on the server during aggregation (0 < x <= 1)
FL_SERVER_LEARNING_RATE=1.0

# Decay factor applied to stale client updates (>= 0)
FL_STALENESS_DECAY=1.0

# Random seed for reproducibility
FL_SEED=42
